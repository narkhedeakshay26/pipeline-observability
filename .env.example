# Copy to .env and edit. .env is git-ignored.

# --- Image versions (pinned; bump deliberately) ---
GRAFANA_VERSION=13.2.3
PROMETHEUS_VERSION=v3.15.0
LOKI_VERSION=3.7.8

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
GRAFANA_PORT=3000

# --- Prometheus ---
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# --- Loki ---
LOKI_PORT=3100
# Retention is set in loki/loki-config.yml (limits_config.retention_period)
