{
  "uid": "pipeline-observability",
  "title": "Pipeline Observability",
  "tags": [
    "prometheus",
    "loki",
    "node-exporter"
  ],
  "description": "Host health, service state and logs for a fleet of pipeline servers.",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "role",
        "label": "Role",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"node\"}, role)",
          "refId": "v"
        },
        "definition": "label_values(up{job=\"node\"}, role)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "host",
        "label": "Host",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"node\", role=~\"$role\"}, host)",
          "refId": "v"
        },
        "definition": "label_values(up{job=\"node\", role=~\"$role\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Search (service / log text)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Fleet overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Host status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Can Prometheus scrape node_exporter on each host? `max by (host)` keeps only the host label so tiles show a clean name.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (host) (up{job=\"node\", host=~\"$host\", role=~\"$role\"})",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "CPU usage",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{job=\"node\", host=~\"$host\", role=~\"$role\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * (1 - max by (host) (node_memory_MemAvailable_bytes{job=\"node\", host=~\"$host\", role=~\"$role\"}) / max by (host) (node_memory_MemTotal_bytes{job=\"node\", host=~\"$host\", role=~\"$role\"}))",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "bargauge",
      "title": "Root disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * (1 - max by (host) (node_filesystem_avail_bytes{job=\"node\", host=~\"$host\", role=~\"$role\", mountpoint=\"/\"}) / max by (host) (node_filesystem_size_bytes{job=\"node\", host=~\"$host\", role=~\"$role\", mountpoint=\"/\"}))",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Load per CPU core (5m)",
      "description": "1.0 = every core busy. Sustained values above ~2 mean work is queuing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (host) (node_load5{job=\"node\", host=~\"$host\", role=~\"$role\"}) / count by (host) (node_cpu_seconds_total{job=\"node\", host=~\"$host\", role=~\"$role\", mode=\"idle\"})",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Network traffic",
      "description": "Inbound above zero, outbound below zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (host) (rate(node_network_receive_bytes_total{job=\"node\", host=~\"$host\", role=~\"$role\", device!~\"lo|veth.*|docker.*|br-.*|virbr.*\"}[$__rate_interval]))",
          "legendFormat": "{{host}} in",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "-sum by (host) (rate(node_network_transmit_bytes_total{job=\"node\", host=~\"$host\", role=~\"$role\", device!~\"lo|veth.*|docker.*|br-.*|virbr.*\"}[$__rate_interval]))",
          "legendFormat": "{{host}} out",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "row",
      "id": 8,
      "title": "Services",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Active services",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (host) (node_systemd_unit_state{job=\"node\", host=~\"$host\", role=~\"$role\", state=\"active\"})",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Inactive services",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Total minus active. A plain count(... == 0) returns *no data* when nothing is down, the most common case, so we subtract instead to get a real 0.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count by (host) (node_systemd_unit_state{job=\"node\", host=~\"$host\", role=~\"$role\", state=\"active\"}) - sum by (host) (node_systemd_unit_state{job=\"node\", host=~\"$host\", role=~\"$role\", state=\"active\"})",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 5
      }
    },
    {
      "type": "table",
      "title": "Service finder",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every watched systemd unit. Use the Search box at the top, or the funnel icon on any column.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "node_systemd_unit_state{job=\"node\", host=~\"$host\", role=~\"$role\", state=\"active\", name=~\".*${search}.*\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "state": true,
              "type": true
            },
            "indexByName": {
              "host": 0,
              "role": 1,
              "name": 2,
              "Value": 3
            },
            "renameByName": {
              "host": "Host",
              "role": "Role",
              "name": "Service",
              "Value": "Status"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Status"
              },
              {
                "field": "Host"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "INACTIVE",
                        "color": "red"
                      },
                      "1": {
                        "text": "ACTIVE",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "countRows": true
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "row",
      "id": 12,
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log volume by service",
      "description": "Lines per interval that survived the agent's drop filter. A sudden jump usually means someone turned on verbose logging.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (unit) (count_over_time({job=\"systemd-journal\", host=~\"$host\", role=~\"$role\"} [$__auto]))",
          "legendFormat": "{{unit}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "interval": "1m"
    },
    {
      "type": "timeseries",
      "title": "Errors by host",
      "description": "Lines with journald priority err or worse.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (host) (count_over_time({job=\"systemd-journal\", host=~\"$host\", role=~\"$role\", level=~\"err|crit|alert|emerg\"} [$__auto]))",
          "legendFormat": "{{host}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "interval": "1m"
    },
    {
      "type": "timeseries",
      "title": "Throughput from logs (records/s)",
      "description": "A metric pulled out of log lines: sums the records=N value from each 'Progress report' line. Adjust the filter and regex to your service's summary line.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (host, unit) (rate({job=\"systemd-journal\", host=~\"$host\", role=~\"$role\"} |= \"Progress report\" | regexp `records=(?P<records>[0-9]+)` | unwrap records [$__auto]))",
          "legendFormat": "{{host}} {{unit}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "interval": "1m"
    },
    {
      "type": "logs",
      "title": "Live logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{job=\"systemd-journal\", host=~\"$host\", role=~\"$role\"} |~ \"(?i)${search}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 12
      }
    }
  ]
}